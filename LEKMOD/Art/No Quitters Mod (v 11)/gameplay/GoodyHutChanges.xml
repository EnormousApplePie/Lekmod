<?xml version="1.0" encoding="utf-8"?>
<!-- Lekmod ruin overhaul -->
<GameData>

	<!-- === GOODY HUT UPDATES === -->
	<GoodyHuts>

		<!-- FOOD: era-scaled food to capital; unit gets Glutton (-10% str, lost on upgrade) -->
		<Update>
			<Set FoodMin="0" FoodMax="0" IncreasePerPop="0" FoodEraScale="1" FreePromotion="PROMOTION_GLUTTON"/>
			<Where Type="GOODY_FOOD"/>
		</Update>

		<!-- UPGRADE: available from turn 6; unit loses 15 HP -->
		<Update>
			<Set AfterTurn="6" UnitDamage="15"/>
			<Where Type="GOODY_UPGRADE_UNIT"/>
		</Update>

		<!-- TECH/SCIENCE: era-scaled science + HP damage + XP; no longer grants free tech -->
		<Update>
			<Set ScienceEraRuin="1"/>
			<Where Type="GOODY_TECH"/>
		</Update>

		<!-- MOBILITY: ancient era only; grant Mobility promotion instead of XP -->
		<Update>
			<Set Type="GOODY_MOBILITY" Experience="0" FreePromotion="PROMOTION_MOBILITY" BeforeEra="1"/>
			<Where Type="GOODY_EXPERIENCE"/>
		</Update>

		<!-- MAP: slightly larger jagged reveal (75% per tile), +6 XP to unit -->
		<Update>
			<Set RevealNearbyBarbariansRange="5" MapOffset="1" MapRange="6" MapProb="75" Experience="6"/>
			<Where Type="GOODY_MAP"/>
		</Update>

		<!-- CULTURE: era-scaled by turn; available from turn 6 -->
		<Update>
			<Set Culture="0" CultureEraTurn="1" AfterTurn="6"/>
			<Where Type="GOODY_CULTURE"/>
		</Update>

		<!-- PANTHEON FAITH: flat 14 faith; only if 0 faith stockpile; available from turn 6 -->
		<Update>
			<Set Faith="14" FaithZeroOnly="1" AfterTurn="6"/>
			<Where Type="GOODY_PANTHEON_FAITH"/>
		</Update>

		<!-- RANDOM FAITH: era-scaled faith (turn * 2 * era); heals unit to full; same conditions as before -->
		<Update>
			<Set FaithMin="0" FaithMax="0" FaithEraTurn="1" Healing="100"/>
			<Where Type="GOODY_RANDOM_FAITH"/>
		</Update>

		<!-- GOLD: base 45 + rand(1-10)*5*era; if total >= 80, spawn era-appropriate barbarian -->
		<Update>
			<Set Gold="45" NumGoldRandRolls="0" GoldRandAmount="0" GoldEraFactor="5" EraBarbarianSpawn="1"/>
			<Where Type="GOODY_GOLD"/>
		</Update>

	</GoodyHuts>

	<!-- Remove standalone barb-reveal from handicap goody pool (merged into Map ruin) -->
	<HandicapInfo_Goodies>
		<Delete GoodyType="GOODY_REVEAL_NEARBY_BARBS"/>
	</HandicapInfo_Goodies>

	<!-- === PROMOTION: GLUTTON (food ruin debuff) === -->
